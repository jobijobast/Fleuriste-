# Copier ce fichier en .env et y mettre la vraie clé.
# .env est ignoré par Git : la clé ne part jamais sur GitHub.

MV_CLE=votre_cle_ici

# Fournisseur. Tout service compatible avec le format OpenAI convient :
#   Mistral   https://api.mistral.ai/v1/chat/completions        open-mistral-nemo
#   OpenAI    https://api.openai.com/v1/chat/completions        gpt-4o-mini
#   Groq      https://api.groq.com/openai/v1/chat/completions   llama-3.3-70b-versatile
MV_URL=https://api.mistral.ai/v1/chat/completions

# Sur le plan gratuit Mistral, mistral-small et mistral-medium renvoient un
# 429 et mistral-large un 403. open-mistral-nemo, ministral-8b et ministral-3b
# passent. Nemo a été retenu : il invente moins et respecte mieux le périmètre.
MV_MODELE=open-mistral-nemo

# Port du serveur local
MV_PORT=5199
